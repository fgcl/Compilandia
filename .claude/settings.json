{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/py.sh \"$CLAUDE_PROJECT_DIR\"/tools/qualidade/confere.py --hook",
            "timeout": 15,
            "statusMessage": "Conferindo o código novo"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/pendencias.sh --hook 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Conferindo o que ficou pendente no git"
          }
        ]
      }
    ]
  }
}
