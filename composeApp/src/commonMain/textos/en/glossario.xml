<?xml version="1.0" encoding="utf-8"?>
<!-- Textos do Compilândia em inglês. Mesmas chaves de textos/pt/glossario.xml. -->
<resources>
    <string name="gl_ver_aula">Watch the lesson</string>
    <string name="gl_fechar">Close</string>
    <string name="gl_token_nome">token</string>
    <string name="gl_token_formas">token|tokens</string>
    <string name="gl_token_def">A piece with a name. In x = 10, the 10 is a token of type number.</string>
    <string name="gl_lexema_nome">lexeme</string>
    <string name="gl_lexema_formas">lexeme|lexemes</string>
    <string name="gl_lexema_def">The exact text of a token. For the token number, the lexeme can be 10.</string>
    <string name="gl_automato_nome">automaton</string>
    <string name="gl_automato_formas">automaton|automata</string>
    <string name="gl_automato_def">A state machine that reads letter by letter and says if it accepts the word.</string>
    <string name="gl_afd_nome">DFA</string>
    <string name="gl_afd_formas">DFA|DFAs</string>
    <string name="gl_afd_def">An automaton where each letter leads to one state only. There is never a doubt.</string>
    <string name="gl_afn_nome">NFA</string>
    <string name="gl_afn_formas">NFA|NFAs</string>
    <string name="gl_afn_def">An automaton that can have several exits for the same letter, or move without reading anything.</string>
    <string name="gl_epsilon_nome">epsilon</string>
    <string name="gl_epsilon_formas">epsilon</string>
    <string name="gl_epsilon_def">The empty word. A rule with epsilon lets the symbol vanish.</string>
    <string name="gl_gramatica_nome">grammar</string>
    <string name="gl_gramatica_formas">grammar|grammars</string>
    <string name="gl_gramatica_def">A set of replacement rules that says which sentences the language accepts.</string>
    <string name="gl_terminal_nome">terminal</string>
    <string name="gl_terminal_formas">terminal|terminals</string>
    <string name="gl_terminal_def">A symbol that shows up in the real program, like id or plus.</string>
    <string name="gl_naoterminal_nome">nonterminal</string>
    <string name="gl_naoterminal_formas">nonterminal|nonterminals</string>
    <string name="gl_naoterminal_def">A symbol that will still be replaced by a rule, like E or T.</string>
    <string name="gl_derivacao_nome">derivation</string>
    <string name="gl_derivacao_formas">derivation|derivations</string>
    <string name="gl_derivacao_def">The chain of replacements that goes from the start symbol to the sentence.</string>
    <string name="gl_ambigua_nome">ambiguous</string>
    <string name="gl_ambigua_formas">ambiguous|ambiguity</string>
    <string name="gl_ambigua_def">A grammar where the same sentence has two different trees.</string>
    <string name="gl_recursao_nome">left recursion</string>
    <string name="gl_recursao_formas">left recursion</string>
    <string name="gl_recursao_def">A rule where the symbol starts with itself, like E goes to E plus T.</string>
    <string name="gl_fatoracao_nome">factoring</string>
    <string name="gl_fatoracao_formas">factoring|factor</string>
    <string name="gl_fatoracao_def">Pulling out the common start of two rules to put off the choice.</string>
    <string name="gl_first_nome">FIRST</string>
    <string name="gl_first_formas">FIRST</string>
    <string name="gl_first_def">The tokens that can start a symbol.</string>
    <string name="gl_follow_nome">FOLLOW</string>
    <string name="gl_follow_formas">FOLLOW</string>
    <string name="gl_follow_def">The tokens that can come right after a symbol.</string>
    <string name="gl_ll1_nome">LL(1)</string>
    <string name="gl_ll1_formas">LL(1)</string>
    <string name="gl_ll1_def">A parser that reads from the left and decides by looking only one token ahead.</string>
    <string name="gl_lookahead_nome">lookahead</string>
    <string name="gl_lookahead_formas">lookahead</string>
    <string name="gl_lookahead_def">The next token in the input, which the parser peeks at to decide.</string>
    <string name="gl_handle_nome">handle</string>
    <string name="gl_handle_formas">handle</string>
    <string name="gl_handle_def">The piece on top of the stack that matches the right side of a rule.</string>
    <string name="gl_shift_nome">shift</string>
    <string name="gl_shift_formas">shift</string>
    <string name="gl_shift_def">Shift: the parser takes the next token and puts it on the stack.</string>
    <string name="gl_reduce_nome">reduce</string>
    <string name="gl_reduce_formas">reduce</string>
    <string name="gl_reduce_def">Reduce: the parser swaps the top of the stack for the left side of a rule.</string>
    <string name="gl_item_nome">item</string>
    <string name="gl_item_formas">item|items</string>
    <string name="gl_item_def">A rule with a dot that marks how much of it was already read.</string>
    <string name="gl_closure_nome">closure</string>
    <string name="gl_closure_formas">closure</string>
    <string name="gl_closure_def">Closure: adds to the state the rules of the symbol right after the dot.</string>
    <string name="gl_goto_nome">goto</string>
    <string name="gl_goto_formas">goto</string>
    <string name="gl_goto_def">Where the LR automaton goes after reading a symbol.</string>
    <string name="gl_conflito_nome">conflict</string>
    <string name="gl_conflito_formas">conflict|conflicts</string>
    <string name="gl_conflito_def">A table cell with two actions. The parser doesn't know what to do.</string>
    <string name="gl_lalr_nome">LALR</string>
    <string name="gl_lalr_formas">LALR</string>
    <string name="gl_lalr_def">An LR(1) table with equal states merged. It ends up the size of the SLR one.</string>
    <string name="gl_precedencia_nome">precedence</string>
    <string name="gl_precedencia_formas">precedence</string>
    <string name="gl_precedencia_def">What gets done first in a sum, like times before plus.</string>
    <string name="gl_atributo_nome">attribute</string>
    <string name="gl_atributo_formas">attribute|attributes</string>
    <string name="gl_atributo_def">A piece of information hanging on a tree node, like the type or the value.</string>
    <string name="gl_escopo_nome">scope</string>
    <string name="gl_escopo_formas">scope|scopes</string>
    <string name="gl_escopo_def">The part of the program where a name is valid.</string>
    <string name="gl_tabelasimbolos_nome">symbol table</string>
    <string name="gl_tabelasimbolos_formas">symbol table</string>
    <string name="gl_tabelasimbolos_def">The list the compiler keeps with each name, its type and its scope.</string>
    <string name="gl_ast_nome">AST</string>
    <string name="gl_ast_formas">AST</string>
    <string name="gl_ast_def">A lean tree: it keeps the operations and the values, with no parentheses or rules.</string>
    <string name="gl_tresenderecos_nome">three-address code</string>
    <string name="gl_tresenderecos_formas">three-address|three-address code</string>
    <string name="gl_tresenderecos_def">Code where each line does a single operation, like t1 = a + b.</string>
    <string name="gl_temporario_nome">temporary</string>
    <string name="gl_temporario_formas">temporary|temporaries</string>
    <string name="gl_temporario_def">A variable the compiler makes up to hold a result, like t1.</string>
    <string name="gl_registrador_nome">register</string>
    <string name="gl_registrador_formas">register|registers</string>
    <string name="gl_registrador_def">A fast drawer inside the processor. MIPS math happens there.</string>
    <string name="gl_mips_nome">MIPS</string>
    <string name="gl_mips_formas">MIPS</string>
    <string name="gl_mips_def">A simple machine language, used to study code generation.</string>
    <string name="gl_registroativacao_nome">activation record</string>
    <string name="gl_registroativacao_formas">activation record|activation records</string>
    <string name="gl_registroativacao_def">The box each function call gets on the stack, with parameters and variables.</string>
    <string name="gl_spill_nome">spill</string>
    <string name="gl_spill_formas">spill</string>
    <string name="gl_spill_def">Keeping a variable in memory when there are not enough registers.</string>
    <string name="gl_cifrao_nome">dollar sign</string>
    <string name="gl_cifrao_formas">dollar sign|$</string>
    <string name="gl_cifrao_def">Marks the end of the input. The start symbol always has the dollar sign in FOLLOW.</string>
</resources>
